Total Bookings = SUM(FactBookings[BookingCount])
Completed Stays = CALCULATE([Total Bookings], DimBookingStatus[BookingStatusName] = "Completed")
Confirmed Stays = CALCULATE([Total Bookings], DimBookingStatus[BookingStatusName] = "Confirmed")
Cancelled Bookings = CALCULATE([Total Bookings], DimBookingStatus[BookingStatusName] = "Cancelled")
Cancellation Rate = DIVIDE([Cancelled Bookings], [Total Bookings])
Booking Value = SUM(FactBookings[BookingAmount])
Noncancelled Booking Value = CALCULATE([Booking Value], DimBookingStatus[BookingStatusName] <> "Cancelled")
Collected Revenue = CALCULATE(SUM(FactPayments[PaymentAmount]), DimPaymentStatus[PaymentStatusName] = "Completed")
Completed Payments = CALCULATE(SUM(FactPayments[PaymentCount]), DimPaymentStatus[PaymentStatusName] = "Completed")
Refunded Amount = CALCULATE(SUM(FactPayments[PaymentAmount]), DimPaymentStatus[PaymentStatusName] = "Refunded")
Average Booking Value = DIVIDE([Booking Value], [Total Bookings])
Average Stay Nights = DIVIDE(SUM(FactBookings[NightCount]), [Total Bookings])
Total Reviews = SUM(FactReviews[ReviewCount])
Average Rating = AVERAGE(FactReviews[Rating])
Total Listings = DISTINCTCOUNT(DimProperty[PropertyKey])
Reviewed Properties = DISTINCTCOUNT(FactReviews[PropertyKey])
Completed Revenue Per Payment = DIVIDE([Collected Revenue], [Completed Payments])
Listings by Location = DISTINCTCOUNT(FactBookings[PropertyKey])
